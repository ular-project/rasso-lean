import Rasso.Form

/-!
# Decidable equality of Rasso forms

Lean's `deriving DecidableEq` does not apply to the mutual, nested types of forms
(`Expr`, `DomExpr`, `Term`, `Agg`, `Cond`), so this file writes the instances by hand. The
recogniser of selection on Boolean function spaces (`Rasso.ESO.Recognise`) uses them to compare a
form with the statement it reads back.

The text below `mutual` is generated by a script (one case for each pair of
constructors); it holds no ideas, only cases.
-/

namespace Rasso.FormEq

open Rasso

mutual
def decExpr : (a b : Expr) → Decidable (a = b)
  | .name a0, .name b0 =>
    match decEq a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .omega a0, .omega b0 =>
    match decHead a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .omegaWhere a0 a1, .omegaWhere b0 b1 =>
    match decHead a0 b0, decTerm a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .omegaRows a0 a1, .omegaRows b0 b1 =>
    match decHead a0 b0, decEq a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .select a0 a1, .select b0 b1 =>
    match decTerm a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .project a0 a1, .project b0 b1 =>
    match decEq a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .rename a0 a1, .rename b0 b1 =>
    match decEq a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .nary a0 a1, .nary b0 b1 =>
    match decEq a0 b0, decExprs a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .gamma a0 a1 a2 a3, .gamma b0 b1 b2 b3 =>
    match decEq a0 b0, decAgg a1 b1, decEq a2 b2, decExpr a3 b3 with
    | isTrue h0, isTrue h1, isTrue h2, isTrue h3 => isTrue (by subst h0; subst h1; subst h2; subst h3; rfl)
    | isFalse h, _, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .extend a0 a1 a2, .extend b0 b1 b2 =>
    match decEq a0 b0, decTerm a1 b1, decExpr a2 b2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .enum a0 a1 a2, .enum b0 b1 b2 =>
    match decEq a0 b0, decOT a1 b1, decExpr a2 b2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .omegaSol a0 a1, .omegaSol b0 b1 =>
    match decExpr a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .sigmaSol a0 a1, .sigmaSol b0 b1 =>
    match decCond a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .enumSol a0 a1 a2, .enumSol b0 b1 b2 =>
    match decEq a0 b0, decOR a1 b1, decExpr a2 b2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .omegaMsol a0 a1, .omegaMsol b0 b1 =>
    match decMem a0 b0, decOC a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .sigmaMsol a0 a1, .sigmaMsol b0 b1 =>
    match decCond a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .enumMsol a0 a1 a2, .enumMsol b0 b1 b2 =>
    match decEq a0 b0, decOR a1 b1, decExpr a2 b2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .flattenMsol a0 a1, .flattenMsol b0 b1 =>
    match decEq a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .dbRef a0 a1, .dbRef b0 b1 =>
    match decEq a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .flatten a0 a1, .flatten b0 b1 =>
    match decEq a0 b0, decExpr a1 b1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .forget a0, .forget b0 =>
    match decExpr a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .lift a0, .lift b0 =>
    match decExpr a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
