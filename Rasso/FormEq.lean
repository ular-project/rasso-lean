  | .hasSubset _, .val _ => isFalse (by intro e; cases e)
  | .hasSubset _, .call _ _ => isFalse (by intro e; cases e)
  | .hasSubset _, .agg _ _ => isFalse (by intro e; cases e)
def decCond : (a b : Cond) → Decidable (a = b)
  | .and a0, .and b0 =>
    match decConds a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .or a0, .or b0 =>
    match decConds a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .not a0, .not b0 =>
    match decCond a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .hasSubset a0, .hasSubset b0 =>
    match decExpr a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .expr a0, .expr b0 =>
    match decExpr a0 b0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
  | .and _, .or _ => isFalse (by intro e; cases e)
  | .and _, .not _ => isFalse (by intro e; cases e)
  | .and _, .hasSubset _ => isFalse (by intro e; cases e)
  | .and _, .expr _ => isFalse (by intro e; cases e)
  | .or _, .and _ => isFalse (by intro e; cases e)
  | .or _, .not _ => isFalse (by intro e; cases e)
  | .or _, .hasSubset _ => isFalse (by intro e; cases e)
  | .or _, .expr _ => isFalse (by intro e; cases e)
  | .not _, .and _ => isFalse (by intro e; cases e)
  | .not _, .or _ => isFalse (by intro e; cases e)
  | .not _, .hasSubset _ => isFalse (by intro e; cases e)
  | .not _, .expr _ => isFalse (by intro e; cases e)
  | .hasSubset _, .and _ => isFalse (by intro e; cases e)
  | .hasSubset _, .or _ => isFalse (by intro e; cases e)
  | .hasSubset _, .not _ => isFalse (by intro e; cases e)
  | .hasSubset _, .expr _ => isFalse (by intro e; cases e)
  | .expr _, .and _ => isFalse (by intro e; cases e)
  | .expr _, .or _ => isFalse (by intro e; cases e)
  | .expr _, .not _ => isFalse (by intro e; cases e)
  | .expr _, .hasSubset _ => isFalse (by intro e; cases e)
def decExprs : (a b : List Expr) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | x :: xs, y :: ys =>
    match decExpr x y, decExprs xs ys with
    | isTrue h, isTrue h' => isTrue (by subst h; subst h'; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decTerms : (a b : List Term) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | x :: xs, y :: ys =>
    match decTerm x y, decTerms xs ys with
    | isTrue h, isTrue h' => isTrue (by subst h; subst h'; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decAggs : (a b : List Agg) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | x :: xs, y :: ys =>
    match decAgg x y, decAggs xs ys with
    | isTrue h, isTrue h' => isTrue (by subst h; subst h'; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decConds : (a b : List Cond) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | x :: xs, y :: ys =>
    match decCond x y, decConds xs ys with
    | isTrue h, isTrue h' => isTrue (by subst h; subst h'; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decHead : (a b : List (String × DomExpr)) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | (s, x) :: xs, (t, y) :: ys =>
    match decEq s t, decDomExpr x y, decHead xs ys with
    | isTrue h0, isTrue h, isTrue h' => isTrue (by subst h0; subst h; subst h'; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decMem : (a b : List (String × Expr)) → Decidable (a = b)
  | [], [] => isTrue rfl
  | [], _ :: _ => isFalse (by intro e; cases e)
  | _ :: _, [] => isFalse (by intro e; cases e)
  | (s, x) :: xs, (t, y) :: ys =>
    match decEq s t, decExpr x y, decMem xs ys with
    | isTrue h0, isTrue h, isTrue h' => isTrue (by subst h0; subst h; subst h'; rfl)
    | isFalse h, _, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decOT : (a b : Option (Order × Term)) → Decidable (a = b)
  | none, none => isTrue rfl
  | none, some _ => isFalse (by intro e; cases e)
  | some _, none => isFalse (by intro e; cases e)
  | some (o, x), some (p, y) =>
    match decEq o p, decTerm x y with
    | isTrue h0, isTrue h => isTrue (by subst h0; subst h; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decOR : (a b : Option (Order × Expr)) → Decidable (a = b)
  | none, none => isTrue rfl
  | none, some _ => isFalse (by intro e; cases e)
  | some _, none => isFalse (by intro e; cases e)
  | some (o, x), some (p, y) =>
    match decEq o p, decExpr x y with
    | isTrue h0, isTrue h => isTrue (by subst h0; subst h; rfl)
    | isFalse h, _ => isFalse (fun e => by cases e; exact h rfl)
    | _, isFalse h => isFalse (fun e => by cases e; exact h rfl)
def decOC : (a b : Option Cond) → Decidable (a = b)
  | none, none => isTrue rfl
  | none, some _ => isFalse (by intro e; cases e)
  | some _, none => isFalse (by intro e; cases e)
  | some x, some y =>
    match decCond x y with
    | isTrue h => isTrue (by subst h; rfl)
    | isFalse h => isFalse (fun e => by cases e; exact h rfl)
end

end Rasso.FormEq

namespace Rasso

instance : DecidableEq Expr := FormEq.decExpr
instance : DecidableEq DomExpr := FormEq.decDomExpr
instance : DecidableEq Term := FormEq.decTerm
instance : DecidableEq Agg := FormEq.decAgg
instance : DecidableEq Cond := FormEq.decCond

end Rasso
